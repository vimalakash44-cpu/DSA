class Solution {
    public int maxFrequency(int[] nums, int k) {
        int n = nums.length;
        Arrays.sort(nums);
        int l = 0;
        int r = 0;
        long windowSum = 0;
        int max = 0;
        while (r < n) {
            windowSum = windowSum + nums[r];
            int num = nums[r];
            long sum = (long) num * (r - l + 1) - windowSum;
            while (sum > k) {
                windowSum = windowSum - nums[l];
                l++;
                sum = (long) num * (r - l + 1) - windowSum;
            }
            max = Math.max(max, r - l + 1);
            r++;
        }
        return max;
    }
}
