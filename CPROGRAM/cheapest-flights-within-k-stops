int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k)
{
    int dist[101];
    int temp[101];
    int i, j;

    for (i = 0; i < n; i++)
        dist[i] = 99999;

    dist[src] = 0;

    for (i = 0; i <= k; i++)
    {
        for (j = 0; j < n; j++)
            temp[j] = dist[j];

        for (j = 0; j < flightsSize; j++)
        {
            int u = flights[j][0];
            int v = flights[j][1];
            int price = flights[j][2];

            if (dist[u] != 99999 &&
                dist[u] + price < temp[v])
            {
                temp[v] = dist[u] + price;
            }
        }

        for (j = 0; j < n; j++)
            dist[j] = temp[j];
    }

    if (dist[dst] == 99999)
        return -1;

    return dist[dst];
}
