int subarrayBitwiseORs(int* arr, int arrSize) {
    int i;
    int j;
    int size=arrSize*(arrSize+1)/2;
    int* ptr=(int*)malloc(size*sizeof(int));
    int index=0;
    for(i=0;i<arrSize;i++){
        int or=0;
        for(j=i;j<arrSize;j++){
            or=or|arr[j];
            *(ptr+index)=or;
            index++;
        }
    }
    int count=0;
    for(i=0;i<index;i++){
        int found = 0;
        for (j = 0; j < i; j++) {
            if (ptr[i] == ptr[j]) {
                found = 1;
                break;
            }
        }
        if (found == 0) {
        count++;
        }
    }
    return count;
}
