int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k)
{
    int graph[101][101] = {0};
    int edge[101][101] = {0};
    int dist[101];
    int visited[101] = {0};
    int i, j, u, min;
    int answer = 0;

    for (i = 0; i < timesSize; i++)
    {
        int source = times[i][0];
        int destination = times[i][1];
        int weight = times[i][2];

        graph[source][destination] = weight;
        edge[source][destination] = 1;
    }

    for (i = 1; i <= n; i++)
    {
        dist[i] = 99999;
    }

    dist[k] = 0;

    for (i = 1; i <= n; i++)
    {
        min = 99999;
        u = -1;

        for (j = 1; j <= n; j++)
        {
            if (!visited[j] && dist[j] < min)
            {
                min = dist[j];
                u = j;
            }
        }

        if (u == -1)
            break;

        visited[u] = 1;

        for (j = 1; j <= n; j++)
        {
            if (edge[u][j] &&
                !visited[j] &&
                dist[u] + graph[u][j] < dist[j])
            {
                dist[j] = dist[u] + graph[u][j];
            }
        }
    }

    for (i = 1; i <= n; i++)
    {
        if (dist[i] == 99999)
            return -1;

        if (dist[i] > answer)
            answer = dist[i];
    }

    return answer;
}
