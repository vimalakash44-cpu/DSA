typedef struct Node
{
    int city;
    int cost;
    struct Node *next;
} Node;

Node *graph[50000];
int visited[50000];

void addEdge(int u, int v, int cost)
{
    Node *newNode = malloc(sizeof(Node));

    newNode->city = v;
    newNode->cost = cost;
    newNode->next = graph[u];

    graph[u] = newNode;
}

int dfs(int u)
{
    int ans = 0;

    visited[u] = 1;

    Node *p = graph[u];

    while (p != NULL)
    {
        if (!visited[p->city])
        {
            ans += p->cost;
            ans += dfs(p->city);
        }

        p = p->next;
    }

    return ans;
}

int minReorder(int n, int** connections,
               int connectionsSize,
               int* connectionsColSize)
{
    int i;

    for (i = 0; i < n; i++)
    {
        graph[i] = NULL;
        visited[i] = 0;
    }

    for (i = 0; i < connectionsSize; i++)
    {
        int u = connections[i][0];
        int v = connections[i][1];

        addEdge(u, v, 1);
        addEdge(v, u, 0);
    }

    return dfs(0);
}
