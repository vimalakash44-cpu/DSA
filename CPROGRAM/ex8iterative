#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

struct Book
{
    int id;
    char title[50];
    char author[50];
    int available;
};

struct Book books[] = {
    {101, "Java", "James", 1},
    {102, "Python", "Guido", 1},
    {103, "C_Programming", "Dennis", 1},
    {104, "Networks", "Tanenbaum", 1}
};

int count = 4;

int main()
{
    int sockfd, newsockfd, choice, id, i, found;
    struct sockaddr_in server, client;
    socklen_t len = sizeof(client);
    char buffer[100], response[500];

    sockfd = socket(AF_INET, SOCK_STREAM, 0);

    server.sin_family = AF_INET;
    server.sin_port = htons(8080);
    server.sin_addr.s_addr = INADDR_ANY;

    bind(sockfd, (struct sockaddr *)&server, sizeof(server));
    listen(sockfd, 5);

    printf("Library Server Running...\n");

    while (1)
    {
        newsockfd = accept(sockfd, (struct sockaddr *)&client, &len);
        printf("Client connected\n");

        while (1)
        {
            int n = recv(newsockfd, buffer, sizeof(buffer) - 1, 0);

            if (n <= 0)
                break;

            buffer[n] = '\0';

            if (strcmp(buffer, "exit") == 0)
                break;

            sscanf(buffer, "%d %d", &choice, &id);
            found = 0;
            response[0] = '\0';

            if (choice == 1)
            {
                for (i = 0; i < count; i++)
                {
                    sprintf(response + strlen(response),
                            "ID:%d Title:%s Author:%s Status:%s\n",
                            books[i].id, books[i].title,
                            books[i].author,
                            books[i].available ? "Available" : "Issued");
                }
            }
            else if (choice >= 2 && choice <= 4)
            {
                for (i = 0; i < count; i++)
                {
                    if (books[i].id == id)
                    {
                        found = 1;
                        break;
                    }
                }

                if (!found)
                    strcpy(response, "Book not found");
                else if (choice == 2)
                    sprintf(response, "Book: %s, Author: %s, Status: %s",
                            books[i].title, books[i].author,
                            books[i].available ? "Available" : "Issued");
                else if (choice == 3)
                {
                    if (books[i].available)
                    {
                        books[i].available = 0;
                        strcpy(response, "Book issued successfully");
                    }
                    else
                        strcpy(response, "Book is already issued");
                }
                else
                {
                    if (!books[i].available)
                    {
                        books[i].available = 1;
                        strcpy(response, "Book returned successfully");
                    }
                    else
                        strcpy(response, "Book was not issued");
                }
            }
            else
                strcpy(response, "Invalid choice");

            send(newsockfd, response, strlen(response) + 1, 0);
        }

        close(newsockfd);
        printf("Client disconnected\n");
    }

    close(sockfd);
    return 0;
}
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

int main()
{
    int sockfd, choice, id, n;
    struct sockaddr_in server;
    char buffer[100], response[500];

    sockfd = socket(AF_INET, SOCK_STREAM, 0);

    server.sin_family = AF_INET;
    server.sin_port = htons(8080);
    server.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sockfd, (struct sockaddr *)&server, sizeof(server)) < 0)
    {
        printf("Connection failed\n");
        close(sockfd);
        return 1;
    }

    while (1)
    {
        printf("\n1. View all books\n");
        printf("2. Search book\n");
        printf("3. Issue book\n");
        printf("4. Return book\n");
        printf("Enter exit to quit\n");
        printf("Enter choice: ");

        if (scanf("%99s", buffer) != 1)
            break;

        if (strcmp(buffer, "exit") == 0)
        {
            send(sockfd, buffer, strlen(buffer) + 1, 0);
            break;
        }

        if (sscanf(buffer, "%d", &choice) != 1 ||
            choice < 1 || choice > 4)
        {
            printf("Invalid choice\n");
            continue;
        }

        id = 0;

        if (choice != 1)
        {
            printf("Enter Book ID: ");
            if (scanf("%d", &id) != 1)
                break;
        }

        sprintf(buffer, "%d %d", choice, id);
        send(sockfd, buffer, strlen(buffer) + 1, 0);

        n = recv(sockfd, response, sizeof(response) - 1, 0);

        if (n <= 0)
        {
            printf("Server disconnected\n");
            break;
        }

        response[n] = '\0';
        printf("\n%s\n", response);
    }

    close(sockfd);
    return 0;
}
