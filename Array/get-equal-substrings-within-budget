class Solution {
    public int equalSubstring(String s, String t, int maxCost) {
        int n = s.length();
        int[] arr1 = new int[n];
        int s3 = maxCost;
        int count = 0;
        for (int i = 0; i < n; i++) {
            char s1 = s.charAt(i);
            char s2 = t.charAt(i);
            arr1[i] = Math.abs(s1 - s2);
        }
        for (int i = 0; i < n; i++) {
            int sum = 0;
            for (int j = i; j < n; j++) {
                sum = sum + arr1[j];
                if (sum > s3) {
                    break;
                }
                count = Math.max(count, j - i + 1);
            }
        }
        return count;
    }
}
