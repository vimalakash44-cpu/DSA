class Solution {
    public String reverseVowels(String s) {
        int n = s.length();
        char[] c;
        c = new char[n];
        c = s.toCharArray();
        String cap = "AEIOU";
        String small = "aeiou";
        int l = 0;
        int r = n - 1;
        while (l <= r) {
            if ((cap.indexOf(c[l]) != -1 || small.indexOf(c[l]) != -1)
                    && (cap.indexOf(c[r]) != -1 || small.indexOf(c[r]) != -1)) {
                char temp = c[l];
                c[l] = c[r];
                c[r] = temp;
                l++;
                r--;
            }
            else if (cap.indexOf(c[l]) != -1 || small.indexOf(c[l]) != -1) {
                r--;
            }
            else if (cap.indexOf(c[r]) != -1 || small.indexOf(c[r]) != -1) {
                l++;
            }
            else {
                l++;
                r--;
            }
        }
        String p = "";
        for (int i = 0; i < n; i++) {
            p = p + c[i];
        }
        return p;
    }
}
