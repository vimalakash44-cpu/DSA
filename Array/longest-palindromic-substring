class Solution {

    public String longestPalindrome(String s) {
        int n = s.length();
        char[] c = s.toCharArray();
        int start = 0;
        int end = 0;
        for (int i = 0; i < n; i++) {
            int l = i;
            int r = i;
            while (l >= 0 && r < n && c[l] == c[r]) {

                if (r - l > end - start) {
                    start = l;
                    end = r;
                }

                l--;
                r++;
            }
            l = i;
            r = i + 1;

            while (l >= 0 && r < n && c[l] == c[r]) {

                if (r - l > end - start) {
                    start = l;
                    end = r;
                }

                l--;
                r++;
            }
        }

        String p = "";

        for (int j = start; j <= end; j++) {
            p = p + c[j];
        }

        return p;
    }
}
